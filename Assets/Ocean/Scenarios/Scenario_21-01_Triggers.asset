  m_Name: Scenario_21-01_Triggers
  m_EditorClassIdentifier: VRBridge.Core::ScenarioDefinition
  id: 21-01
  title: "\u0424\u0430\u0440\u0432\u0430\u0442\u0435\u0440 \u0441 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u0430\u043C\u0438"
  briefing: "\u0421\u0432\u043E\u0451 \u0441\u0443\u0434\u043D\u043E \u2014 \u0432
    1,2 \u043C\u0438\u043B\u0438 \u043A \u044E\u0433\u0443 \u043E\u0442 \u0432\u0445\u043E\u0434\u0430
    \u0432 \u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440,
    \u043A\u0443\u0440\u0441 000\xB0, \u043F\u043E\u043B\u043D\u044B\u0439 \u0445\u043E\u0434
    15 \u0443\u0437.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u043F\u0440\u043E\u0439\u0442\u0438
    \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u043E\u043C \u043F\u043E \u043F\u0443\u0442\u0435\u0432\u044B\u043C
    \u0442\u043E\u0447\u043A\u0430\u043C, \u043A\u0430\u043A \u0432 \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u0438
    B2-01: \u0432\u0445\u043E\u0434 \u0432 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440,
    \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0432\u043F\u0440\u0430\u0432\u043E
    \u043D\u0430 60\xB0, \u0432\u044B\u0445\u043E\u0434 \u0438\u0437 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u0430.
    \u0412 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u0435 \u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C
    \u0443 \u043E\u0441\u0438 \u0441 \u043F\u0440\u0430\u0432\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    (\u043F\u0440\u0430\u0432\u0438\u043B\u043E 9 \u041C\u041F\u041F\u0421\u0421).\n\n\u041E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430
    \u0432 \u0440\u0430\u0439\u043E\u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F
    \u043F\u043E \u0445\u043E\u0434\u0443 \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u044F:
    \u0441\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F\u043C\u0438,
    \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0441\u0443\u0434\u0430\u043C\u0438
    \u0438 \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C\u044E \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435
    \u043F\u043E \u041C\u041F\u041F\u0421\u0421-72.\n\n\u0421\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435
    \u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0430 \u043D\u0430 \u043C\u0435\u043B\u044C
    \u2014 \u043F\u0440\u043E\u0432\u0430\u043B \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u044F.
    \u041B\u0438\u043C\u0438\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2014
    30 \u043C\u0438\u043D\u0443\u0442."
