  m_Name: Scenario_19-03_TugWork
  m_EditorClassIdentifier: VRBridge.Core::ScenarioDefinition
  id: 19-03
  title: "\u0411\u0443\u043A\u0441\u0438\u0440 \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u0435\u0442
    \u0441\u0443\u0434\u043D\u043E \u043A \u043F\u0440\u0438\u0447\u0430\u043B\u0443"
  briefing: "\u0414\u0435\u043D\u044C, \u0432\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u043D\u0435\u0442. \u0412\u0435\u0442\u0435\u0440 15 \u0443\u0437, \u043E\u0442\u0436\u0438\u043C\u043D\u043E\u0439
    \u2014 \u0434\u0443\u0435\u0442 \u0441 \u043F\u0440\u0438\u0447\u0430\u043B\u0430
    \u0438 \u0441\u043D\u043E\u0441\u0438\u0442 \u0441\u0443\u0434\u043D\u043E \u043E\u0442
    \u043A\u0440\u043E\u043C\u043A\u0438. \u0412\u044B \u2014 \u043D\u0430 \u0431\u0443\u043A\u0441\u0438\u0440\u0435
    (22 \u043C, \u0434\u0432\u0435 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u0435
    \u043A\u043E\u043B\u043E\u043D\u043A\u0438, \u0442\u044F\u0433\u0430 \u043D\u0430
    \u0433\u0430\u043A\u0435 20 \u0442). \u0421\u0443\u0445\u043E\u0433\u0440\u0443\u0437
    161 \u043C \u0441\u0442\u043E\u0438\u0442 \u043B\u0430\u0433\u043E\u043C \u0432
    30 \u043C \u043E\u0442 \u043F\u0440\u0438\u0447\u0430\u043B\u0430 \u21162, \u043F\u0440\u0438\u0447\u0430\u043B
    \u0443 \u043D\u0435\u0433\u043E \u043F\u043E \u043B\u0435\u0432\u043E\u043C\u0443
    \u0431\u043E\u0440\u0442\u0443; \u043C\u0430\u0448\u0438\u043D\u043E\u0439 \u0438
    \u043F\u043E\u0434\u0440\u0443\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u043C
    \u043E\u043D \u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043A\u0443\u0440\u0441 \u0438 \u043C\u0435\u0441\u0442\u043E \u0432\u0434\u043E\u043B\u044C
    \u043F\u0440\u0438\u0447\u0430\u043B\u0430 \u2014 \u043A \u043F\u0440\u0438\u0447\u0430\u043B\u0443
    \u0435\u0433\u043E \u0432\u0435\u0434\u0451\u0442\u0435 \u0432\u044B.\n\n\u0420\u0430\u0431\u043E\u0442\u0430\u0439\u0442\u0435
    \u043F\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0430\u043C \u043B\u043E\u0446\u043C\u0430\u043D\u0430
    (\u0423\u041A\u0412):\n  1. \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A
    \u043F\u0440\u0430\u0432\u043E\u043C\u0443 \u0431\u043E\u0440\u0442\u0443 \u0443
    \u043C\u0438\u0434\u0435\u043B\u044F \u0438 \u0443\u043F\u0435\u0440\u0435\u0442\u044C\u0441\u044F
    \u043D\u043E\u0441\u043E\u0432\u044B\u043C \u043A\u0440\u0430\u043D\u0446\u0435\u043C
    \u2014 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043D\u043E\u0441\u043E\u043C
    \u043F\u043E\u043F\u0435\u0440\u0451\u043A \u0431\u043E\u0440\u0442\u0430;\n 
    2. \u043F\u0440\u0438\u0436\u0430\u0442\u044C \u0441\u0443\u0434\u043D\u043E
    \u043A \u043F\u0440\u0438\u0447\u0430\u043B\u0443 \u2014 \u0443\u043F\u043E\u0440
    \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u0442\u0430\u043A\u0438\u043C, \u043A\u0430\u043A\u043E\u0439
    \u043D\u0430\u0437\u043E\u0432\u0451\u0442 \u043B\u043E\u0446\u043C\u0430\u043D:
    \xAB\u0442\u043E\u043B\u043A\u0430\u0439 \u0441\u0430\u043C\u044B\u043C \u043C\u0430\u043B\u044B\u043C
    / \u043C\u0430\u043B\u044B\u043C / \u0441\u0440\u0435\u0434\u043D\u0438\u043C
    / \u043F\u043E\u043B\u043D\u044B\u043C\xBB (\u0441\u0442\u0443\u043F\u0435\u043D\u0438
    \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0438 25 / 50 / 75 / 100 %), \xAB\u0441\u0442\u043E\u043F
    \u0442\u043E\u043B\u043A\u0430\u0442\u044C\xBB;\n  3. \u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0443\u043F\u043E\u0440, \u043F\u043E\u043A\u0430 \u0441\u0443\u0434\u043D\u043E
    \u0437\u0430\u0432\u043E\u0434\u0438\u0442 \u043A\u043E\u043D\u0446\u044B;\n 
    4. \u043F\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0435 \xAB\u043E\u0442\u0445\u043E\u0434\u0438\u0442\u0435\xBB
    \u043E\u0442\u043E\u0439\u0442\u0438 \u043E\u0442 \u0431\u043E\u0440\u0442\u0430,
    \u043D\u0435 \u0437\u0430\u0434\u0435\u0432 \u0435\u0433\u043E \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u043C.\n\n\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u2014 \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A \u043D\u0430 \u043F\u0443\u043B\u044C\u0442\u0435:
    \u043D\u0430\u043A\u043B\u043E\u043D \u0432\u043F\u0435\u0440\u0451\u0434-\u043D\u0430\u0437\u0430\u0434
    \u2014 \u0445\u043E\u0434, \u0432\u0431\u043E\u043A \u2014 \u043B\u0430\u0433\u043E\u043C,
    \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0438
    \u2014 \u0440\u0430\u0437\u0432\u043E\u0440\u043E\u0442; \u0441\u0442\u0443\u043F\u0435\u043D\u0438
    \u0443\u043F\u043E\u0440\u0430 \u2014 \u0441\u043E \u0449\u0435\u043B\u0447\u043A\u043E\u043C.
    \u041C\u043E\u043D\u0438\u0442\u043E\u0440 \u043F\u0443\u043B\u044C\u0442\u0430
    \u2014 \u0445\u043E\u0434, \u043B\u0430\u0433\u043E\u043C, \u043A\u043E\u043C\u0430\u043D\u0434\u0430
    \u043B\u043E\u0446\u043C\u0430\u043D\u0430; \u043A\u043E\u043B\u043E\u043D\u043A\u0438
    \u2014 \u043D\u0430 \u043B\u0435\u0432\u043E\u043C \u044D\u043A\u0440\u0430\u043D\u0435.\n\n\u041B\u0438\u043C\u0438\u0442
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2014 20 \u043C\u0438\u043D\u0443\u0442."
