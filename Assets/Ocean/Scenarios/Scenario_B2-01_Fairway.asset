  m_Name: Scenario_B2-01_Fairway
  m_EditorClassIdentifier: VRBridge.Core::ScenarioDefinition
  id: B2-01
  title: "\u041F\u0440\u043E\u0445\u043E\u0434 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u043E\u043C
    \u043F\u043E \u043F\u0443\u0442\u0435\u0432\u044B\u043C \u0442\u043E\u0447\u043A\u0430\u043C"
  briefing: "\u0421\u0432\u043E\u0451 \u0441\u0443\u0434\u043D\u043E \u2014 \u0432
    1,2 \u043C\u0438\u043B\u0438 (2,2 \u043A\u043C) \u043A \u044E\u0433\u0443 \u043E\u0442
    \u0432\u0445\u043E\u0434\u0430 \u0432 \u0443\u0447\u0435\u0431\u043D\u044B\u0439
    \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440, \u043A\u0443\u0440\u0441 000\xB0,
    \u043F\u043E\u043B\u043D\u044B\u0439 \u0445\u043E\u0434 15 \u0443\u0437.\n\n\u0417\u0430\u0434\u0430\u0447\u0430:
    \u043F\u0440\u043E\u0439\u0442\u0438 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u043E\u043C
    \u043F\u043E \u043F\u0443\u0442\u0435\u0432\u044B\u043C \u0442\u043E\u0447\u043A\u0430\u043C:\n 
    1. \u0412\u0445\u043E\u0434 \u0432 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440
    \u2014 \u0437\u0430 \u043E\u0441\u0435\u0432\u044B\u043C \u0437\u043D\u0430\u043A\u043E\u043C,
    \u0443 \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u0430\u0440\u044B \u0431\u0443\u0451\u0432;\n 
    2. \u0422\u043E\u0447\u043A\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430
    \u2014 \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0432\u043F\u0440\u0430\u0432\u043E
    \u043D\u0430 60\xB0, \u043D\u0430 \u043A\u0443\u0440\u0441 060\xB0;\n  3. \u0412\u044B\u0445\u043E\u0434
    \u0438\u0437 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u0430.\n\n\u0414\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C
    \u043E\u0441\u0438 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u0430. \u0414\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u043E\u0435
    \u0431\u043E\u043A\u043E\u0432\u043E\u0435 \u043E\u0442\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435
    \u2014 250 \u043C \u043D\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0435 \u0438
    150 \u043C \u0432 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u0435.\n\n\u0424\u0430\u0440\u0432\u0430\u0442\u0435\u0440
    \u0448\u0438\u0440\u0438\u043D\u043E\u0439 2 \u043A\u0431\u0442 \u043E\u0433\u0440\u0430\u0436\u0434\u0451\u043D
    \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0437\u043D\u0430\u043A\u0430\u043C\u0438
    \u041C\u0410\u041C\u0421 (\u0440\u0435\u0433\u0438\u043E\u043D A): \u043A\u0440\u0430\u0441\u043D\u044B\u0435
    \u2014 \u0441\u043B\u0435\u0432\u0430, \u0437\u0435\u043B\u0451\u043D\u044B\u0435
    \u2014 \u0441\u043F\u0440\u0430\u0432\u0430 \u043F\u043E \u0445\u043E\u0434\u0443
    \u0441 \u043C\u043E\u0440\u044F. \u0417\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C
    \u0438 \u0441 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u2014 \u043E\u0442\u043C\u0435\u043B\u0438,
    \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0435 \u043A\u0430\u0440\u0434\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u0437\u043D\u0430\u043A\u0430\u043C\u0438; \u043A \u0432\u043E\u0441\u0442\u043E\u043A\u0443
    \u043E\u0442 \u043B\u0438\u043D\u0438\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u0430
    \u2014 \u043A\u0430\u043C\u0435\u043D\u044C \u0441\u043E \u0437\u043D\u0430\u043A\u043E\u043C
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.\n\n\u041B\u0438\u043C\u0438\u0442
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2014 30 \u043C\u0438\u043D\u0443\u0442."
