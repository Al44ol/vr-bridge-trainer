  m_Name: Scenario_B3-01_Traffic
  m_EditorClassIdentifier: VRBridge.Core::ScenarioDefinition
  id: B3-01
  title: "\u0420\u0430\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0441
    \u0441\u0443\u0434\u0430\u043C\u0438 \u043D\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0435
    \u0438 \u0432 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u0435"
  briefing: "\u041D\u043E\u0447\u044C. \u0421\u0432\u043E\u0451 \u0441\u0443\u0434\u043D\u043E
    \u2014 \u0432 1,2 \u043C\u0438\u043B\u0438 \u043A \u044E\u0433\u0443 \u043E\u0442
    \u0432\u0445\u043E\u0434\u0430 \u0432 \u0443\u0447\u0435\u0431\u043D\u044B\u0439
    \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440, \u043A\u0443\u0440\u0441 000\xB0,
    \u043F\u043E\u043B\u043D\u044B\u0439 \u0445\u043E\u0434 15 \u0443\u0437. \u041C\u0430\u0440\u0448\u0440\u0443\u0442
    \u2014 \u043A\u0430\u043A \u0432 \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u0438
    B2-01: \u0432\u0445\u043E\u0434 \u0432 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440,
    \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0432\u043F\u0440\u0430\u0432\u043E
    \u043D\u0430 60\xB0, \u0432\u044B\u0445\u043E\u0434 \u0438\u0437 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u0430.\n\n\u0412
    \u0440\u0430\u0439\u043E\u043D\u0435 \u2014 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0441\u0443\u0434\u0430. \u041D\u0430\u0431\u043B\u044E\u0434\u0430\u0439\u0442\u0435
    \u0437\u0430 \u043E\u0433\u043D\u044F\u043C\u0438, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0439\u0442\u0435
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E \u0441\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u044F
    \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u043F\u043E
    \u041C\u041F\u041F\u0421\u0421-72 (\u043F\u0440\u0430\u0432\u0438\u043B\u0430
    9, 13\u201317): \u043D\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430
    \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0441\u0443\u0434\u043D\u043E\u043C,
    \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u044E\u0449\u0438\u043C \u043A\u0443\u0440\u0441;
    \u0432 \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440\u0435 \u2014 \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u043E\u0435
    \u0438 \u043F\u043E\u043F\u0443\u0442\u043D\u043E\u0435 \u0441\u0443\u0434\u0430.\n\n\u0421\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435
    \u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0430 \u043D\u0430 \u043C\u0435\u043B\u044C
    \u2014 \u043F\u0440\u043E\u0432\u0430\u043B \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u044F.
    \u041B\u0438\u043C\u0438\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2014
    30 \u043C\u0438\u043D\u0443\u0442."
