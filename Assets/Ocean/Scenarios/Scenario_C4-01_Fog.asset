  m_Name: Scenario_C4-01_Fog
  m_EditorClassIdentifier: VRBridge.Core::ScenarioDefinition
  id: 03
  title: "\u041F\u043B\u0430\u0432\u0430\u043D\u0438\u0435 \u0432 \u0442\u0443\u043C\u0430\u043D\u0435"
  briefing: "\u0414\u0435\u043D\u044C, \u0448\u0442\u0438\u043B\u044C, \u0422\u0423\u041C\u0410\u041D:
    \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C \u043E\u043A\u043E\u043B\u043E
    0,5 \u043C\u0438\u043B\u0438 (900 \u043C). \u0421\u0432\u043E\u0451 \u0441\u0443\u0434\u043D\u043E
    \u2014 \u0432 1,6 \u043C\u0438\u043B\u0438 \u043A \u044E\u0433\u0443 \u043E\u0442
    \u0432\u0445\u043E\u0434\u0430 \u0432 \u0443\u0447\u0435\u0431\u043D\u044B\u0439
    \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440, \u043A\u0443\u0440\u0441 000\xB0,
    \xAB\u0421\u0440\u0435\u0434\u043D\u0438\u0439 \u0432\u043F\u0435\u0440\u0451\u0434\xBB.\n\n\u0417\u0430\u0434\u0430\u0447\u0430:
    \u0434\u043E\u0439\u0442\u0438 \u0434\u043E \u0432\u0445\u043E\u0434\u0430 \u0432
    \u0444\u0430\u0440\u0432\u0430\u0442\u0435\u0440 (\u043E\u0441\u0435\u0432\u043E\u0439
    \u0437\u043D\u0430\u043A, \u043F\u0435\u0440\u0432\u0430\u044F \u043F\u0430\u0440\u0430
    \u0431\u0443\u0451\u0432).\n\n\u0412 \u0440\u0430\u0439\u043E\u043D\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B
    \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u0443\u0434\u0430; \u043D\u0430 \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u0435
    \u043E\u043D\u0438 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u2014 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0439\u0442\u0435 \u0438 \u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435.
    \u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u043F\u043E \u041C\u041F\u041F\u0421\u0421-72
    \u0434\u043B\u044F \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439
    \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438: \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0430\u044F
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C (\u043F\u0440\u0430\u0432\u0438\u043B\u0430
    6, 19 \u0431), \u0442\u0443\u043C\u0430\u043D\u043D\u044B\u0435 \u0441\u0438\u0433\u043D\u0430\u043B\u044B
    (\u043F\u0440\u0430\u0432\u0438\u043B\u043E 35), \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F,
    \u0443\u0441\u043B\u044B\u0448\u0430\u0432 \u0441\u0438\u0433\u043D\u0430\u043B
    \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0441\u0443\u0434\u043D\u0430 (\u043F\u0440\u0430\u0432\u0438\u043B\u043E
    19 \u0433, \u0434).\n\n\u0413\u0443\u0434\u043E\u043A (\u043A\u043D\u043E\u043F\u043A\u0430
    \xAB\u0422\u0418\u0424\u041E\u041D\xBB) \u0437\u0432\u0443\u0447\u0438\u0442,
    \u043F\u043E\u043A\u0430 \u0435\u0451 \u0434\u0435\u0440\u0436\u0430\u0442: \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0437\u0432\u0443\u043A \u2014 4\u20136 \u0441, \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
    \u2014 \u043E\u043A\u043E\u043B\u043E 1 \u0441.\n\n\u0421\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435
    \u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0430 \u043D\u0430 \u043C\u0435\u043B\u044C
    \u2014 \u043F\u0440\u043E\u0432\u0430\u043B \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u044F.
    \u041B\u0438\u043C\u0438\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2014
    35 \u043C\u0438\u043D\u0443\u0442."
