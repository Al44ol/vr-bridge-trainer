  m_Script: {fileID: 11500000, guid: e8aead3d1f914e5fb4a3cfb565c3a99a, type: 3}
  m_Name: Scenario_19-02_TugBerth
  m_EditorClassIdentifier: VRBridge.Core::ScenarioDefinition
  id: 19-02
  title: "\u0428\u0432\u0430\u0440\u0442\u043E\u0432\u043A\u0430 \u0441 \u0431\u0443\u043A\u0441\u0438\u0440\u043E\u043C
    \u043F\u0440\u0438 \u043E\u0442\u0436\u0438\u043C\u043D\u043E\u043C \u0432\u0435\u0442\u0440\u0435"
  briefing: "\u0414\u0435\u043D\u044C, \u0432\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u043D\u0435\u0442. \u0412\u0435\u0442\u0435\u0440 20 \u0443\u0437, \u043E\u0442\u0436\u0438\u043C\u043D\u043E\u0439
    \u2014 \u0434\u0443\u0435\u0442 \u0441 \u043F\u0440\u0438\u0447\u0430\u043B\u0430,
    \u0441\u043D\u043E\u0441\u0438\u0442 \u0441\u0443\u0434\u043D\u043E \u043E\u0442
    \u043A\u0440\u043E\u043C\u043A\u0438. \u0421\u0432\u043E\u0451 \u0441\u0443\u0434\u043D\u043E
    \u0438\u0434\u0451\u0442 \u0441\u0430\u043C\u044B\u043C \u043C\u0430\u043B\u044B\u043C
    \u0445\u043E\u0434\u043E\u043C \u0432\u0434\u043E\u043B\u044C \u043F\u0440\u0438\u0447\u0430\u043B\u0430
    \u21161, \u0432 200 \u043C \u0434\u043E \u0435\u0433\u043E \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B
    \u0438 \u0432 30 \u043C \u043E\u0442 \u043A\u0440\u043E\u043C\u043A\u0438. \u041F\u0440\u0438\u0447\u0430\u043B
    \u2014 \u043F\u043E \u043B\u0435\u0432\u043E\u043C\u0443 \u0431\u043E\u0440\u0442\u0443.\n\n\u0417\u0430\u0434\u0430\u0447\u0430:
    \u043E\u0448\u0432\u0430\u0440\u0442\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u043B\u0435\u0432\u044B\u043C \u0431\u043E\u0440\u0442\u043E\u043C \u043A \u043F\u0440\u0438\u0447\u0430\u043B\u0443
    \u21161:\n  1. \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u043B\u0430\u0433\u043E\u043C;\n 
    2. \u043F\u043E\u0433\u0430\u0441\u0438\u0442\u044C \u0445\u043E\u0434 \u0438
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F \u0443
    \u043A\u0440\u0430\u043D\u0446\u0435\u0432;\n  3. \u043F\u043E\u0434\u0430\u0442\u044C
    \u043A\u043E\u043D\u0446\u044B \u0441 \u043D\u043E\u0441\u0430 \u0438 \u043A\u043E\u0440\u043C\u044B;\n 
    4. \u043E\u0431\u0442\u044F\u043D\u0443\u0442\u044C \u043A\u043E\u043D\u0446\u044B
    \u0438 \u0441\u0442\u043E\u044F\u0442\u044C \u0443 \u043A\u0440\u0430\u043D\u0446\u0435\u0432
    \u0431\u0435\u0437 \u0445\u043E\u0434\u0430.\n\n\u041F\u0440\u043E\u0442\u0438\u0432
    \u0442\u0430\u043A\u043E\u0433\u043E \u0432\u0435\u0442\u0440\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
    \u043F\u043E\u0434\u0440\u0443\u043B\u0438\u0432\u0430\u044E\u0449\u0435\u0433\u043E
    \u043C\u0430\u043B\u043E: \u0432 \u0432\u0430\u0448\u0435\u043C \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0438
    \u0431\u0443\u043A\u0441\u0438\u0440 (\u043C\u0435\u043D\u044E \xAB\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\xBB
    \u2192 \xAB\u0411\u0443\u043A\u0441\u0438\u0440\xBB). \u0420\u0435\u0448\u0438\u0442\u0435
    \u0441\u0430\u043C\u0438, \u0433\u0434\u0435 \u0435\u0433\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    (\u0443 \u043A\u043E\u0440\u043C\u044B, \u0443 \u043D\u043E\u0441\u0430 \u0438\u043B\u0438
    \u0443 \u043C\u0438\u0434\u0435\u043B\u044F), \u0442\u044F\u043D\u0443\u0442\u044C
    \u0438\u043B\u0438 \u0442\u043E\u043B\u043A\u0430\u0442\u044C \u0438 \u0441 \u043A\u0430\u043A\u043E\u0439
    \u0442\u044F\u0433\u043E\u0439. \u041D\u0435 \u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0442\u044F\u0433\u0443 \u043D\u0430
    \u0441\u043B\u0430\u0431\u043E\u043C \u0442\u0440\u043E\u0441\u0435 (\u0440\u044B\u0432\u043E\u043A)
    \u0438 \u043D\u0435 \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u0439\u0442\u0435
    \u0441\u0443\u0434\u043D\u043E \u043A \u043F\u0440\u0438\u0447\u0430\u043B\u0443
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u043F\u0440\u0438
    \u043E\u0431\u044B\u0447\u043D\u043E\u043C \u043D\u0430\u0432\u0430\u043B\u0435.\n\n\u041A\u043E\u043C\u0430\u043D\u0434\u044B
    \u2014 \u043C\u0435\u043D\u044E \xAB\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\xBB
    (\u043A\u043D\u043E\u043F\u043A\u0430 B): \u0440\u0443\u043B\u044C, \u043C\u0430\u0448\u0438\u043D\u0430,
    \u043F\u043E\u0434\u0440\u0443\u043B\u0438\u0432\u0430\u044E\u0449\u0435\u0435,
    \u043A\u043E\u043D\u0446\u044B, \u0431\u0443\u043A\u0441\u0438\u0440, \u043F\u0435\u0440\u0435\u0445\u043E\u0434
    \u043D\u0430 \u043A\u0440\u044B\u043B\u043E. \u0420\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F
    \u0434\u043E \u043A\u0440\u043E\u043C\u043A\u0438 \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
    \u043A \u043F\u0440\u0438\u0447\u0430\u043B\u0443 \u2014 \u0441\u0442\u0440\u043E\u043A\u0430
    \xAB\u041F\u0420\u0418\u0427\u0410\u041B\xBB \u043D\u0430 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u043C
    \u0434\u0438\u0441\u043F\u043B\u0435\u0435.\n\n\u041B\u0438\u043C\u0438\u0442
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2014 25 \u043C\u0438\u043D\u0443\u0442."
